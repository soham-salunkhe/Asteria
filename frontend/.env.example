# ──────────────────────────────────────────────────────
# MICHIRA — Firebase configuration
# Copy this file to .env and fill in your project values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# FSOC Virtual PAT backend
# Leave unset to use the Vite dev proxy (localhost AND LAN devices work).
# Override only for a deployed (non-Vite) backend.
# VITE_FSOC_API_URL=http://localhost:8000
# VITE_FSOC_WS_URL=ws://localhost:8000/ws/simulation
